# ProcureAI — environment template. Copy to backend/.env and fill in real values.
# In APP_ENV=staging|production every critical provider must be real: boot fails, listing the
# missing variables, instead of silently running a fake (see docs/ENVIRONMENT.md §2).
# Full variable reference: docs/ENVIRONMENT.md

# ------------------------------------------------------------------ core
APP_NAME=ProcureAI
APP_ENV=dev                      # dev | test | staging | production
API_PREFIX=/api/v1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240         # authenticated requests per minute per user
RATE_LIMIT_ANONYMOUS_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_LOGIN_PER_IP=120
SECRET_KEY=                      # REQUIRED, 32+ chars, no default in prod
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
REQUIRE_MFA=false
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DEFAULT_TIMEZONE=Africa/Cairo
# Outbound supplier contact window (tenant-local hours). Autonomous sends outside it are blocked
# and queued; the policy engine still lets a human send any time.
CONTACT_HOURS_START=7
CONTACT_HOURS_END=21

# ------------------------------------------------------------------ data
# PostgreSQL 16 is the only supported database (RLS, pg_trgm and pgvector are PostgreSQL-only).
# Inside compose the host is `db`; for a PostgreSQL running on your machine use localhost.
DATABASE_URL=postgresql+asyncpg://procureai:change-me@db:5432/procureai
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000      # statement_timeout on every connection
# Escape hatch for sandboxes with no PostgreSQL server. Never enable in staging/production:
# it downgrades tenant isolation (no RLS) and disables full-text/vector search.
ALLOW_SQLITE_FALLBACK=false
REDIS_URL=redis://redis:6379/0
TENANT_RLS_ENABLED=true
# Deliberately keep the deterministic fakes in a staging box (logs a warning per provider).
ALLOW_FAKE_PROVIDERS=false

# ------------------------------------------------------------------ bootstrap
BOOTSTRAP_ON_START=true
BOOTSTRAP_DEMO_TENANT=true
BOOTSTRAP_SUPERADMIN_EMAIL=owner@mantiq.tech
BOOTSTRAP_SUPERADMIN_PASSWORD=      # blank => generated and printed once by `procureai bootstrap`
BOOTSTRAP_ADMIN_EMAIL=admin@pilot.procureai
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEMO_PASSWORD=Demo!Pilot2026
DEMO_SEED_ON_START=true            # seed suppliers, items and history at boot

# ------------------------------------------------------------------ LLM
LLM_PROVIDER=fake                  # fake (dev/test) | anthropic | openai_compatible
LLM_API_KEY=                       # anthropic key or bearer token
LLM_MODEL=claude-sonnet-4-5        # exact model id; never hard-coded in the app
LLM_BASE_URL=                      # anthropic: gateway URL | openai_compatible: include /v1
                                   # e.g. https://api.openai.com/v1 or http://vllm:8000/v1

# ------------------------------------------------------------------ adapters (fake by default)
SEARCH_PROVIDER=fake               # fake | serpapi | brave
SEARCH_API_KEY=
EMAIL_PROVIDER=fake                # fake | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rfq@procureai.local
WHATSAPP_ENABLED=true
VOICE_AI_ENABLED=true
VOICE_ASSISTANT_ENABLED=true
WS_FANOUT_ENABLED=true             # live events via Redis pub/sub; required for >1 replica
WHATSAPP_PROVIDER=fake             # fake | twilio | cloud_api
WHATSAPP_TOKEN=                    # cloud_api only
WHATSAPP_PHONE_ID=                 # cloud_api only
WHATSAPP_VERIFY_TOKEN=verify-me    # cloud_api only
WHATSAPP_APP_SECRET=               # cloud_api webhook payload signature
WHATSAPP_QUOTE_FLOW_ID=            # optional published Flow for the structured quote form
WHATSAPP_DAILY_CAP=400             # outbound WhatsApp messages per tenant per day
WHATSAPP_SESSION_WINDOW_HOURS=24   # free-form reply window before a template is required

# ------------------------------------------------------------------ Twilio (WhatsApp + SMS + voice)
# One account serves all three channels. TWILIO_* win over the legacy TELEPHONY_* aliases.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=              # e.g. whatsapp:+14155238886 (sandbox) or an approved sender
TWILIO_SMS_FROM=                   # e.g. +12025550123
TWILIO_WEBHOOK_URL=                # public URL Twilio signs, e.g. https://api.example.com/api/v1/inbound/whatsapp
TWILIO_BASE_URL=https://api.twilio.com
SMS_PROVIDER=fake                  # fake | twilio
TELEPHONY_PROVIDER=fake            # fake | twilio
TELEPHONY_SID=                     # legacy aliases, used when TWILIO_* are empty
TELEPHONY_TOKEN=
TELEPHONY_FROM=
OCR_PROVIDER=fake                  # fake | tesseract
STT_PROVIDER=fake                  # fake | whisper
PAYMENT_PROVIDER=fake              # fake | stripe
STRIPE_KEY=
ERP_PROVIDER=file                  # file | odoo

# ------------------------------------------------------------------ security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
ENCRYPTION_MASTER_KEY=             # REQUIRED in prod; losing it makes supplier PII unreadable
AWS_STORAGE_BUCKET=
AWS_ENDPOINT=                      # e.g. http://minio:9000
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ------------------------------------------------------------------ observability
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
